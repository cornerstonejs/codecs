{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^14.1.0",
    "semver": "^7.7.1",
    "vitest": "^3.2.4",
    "playwright-core": "^1.49.0"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "build:all": "pnpm -r --parallel run build:ci",
    "test": "vitest run",
    "test:all": "pnpm -r --parallel run test:ci",
    "bench": "pnpm -r --parallel run bench",
    "bench:ci": "pnpm -r --parallel run bench",
    "build:ci": "pnpm --parallel --filter \"...[origin/main]\" run build:ci",
    "test:ci": "pnpm --parallel --filter \"...[origin/main]\" run test:ci",
    "build:publish": "pnpm -r --parallel run build:ci",
    "docker:build": "bash tools/docker/build.sh",
    "release:plan": "node tools/release/version.mjs --dry-run"
  }
}
